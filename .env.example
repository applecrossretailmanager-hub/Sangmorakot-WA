# Supabase project settings — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, never exposed to the browser. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
# Stripe — Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of this site, used for Stripe redirect/return URLs.
# Locally: http://localhost:3000. On Vercel this can be left unset —
# it falls back to the deployment's VERCEL_URL — but setting it to your
# production domain is recommended once you have one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
