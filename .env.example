# Supabase project settings — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, never exposed to the browser. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
# Stripe — Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — used to email customers when an async bank-debit payment
# (membership renewal or PT package) succeeds or fails. Create a
# sending-access API key at resend.com for your verified domain.
RESEND_API_KEY=re_...

# Public URL of this site, used for Stripe redirect/return URLs.
# Locally: http://localhost:3000. On Vercel this can be left unset —
# it falls back to the deployment's VERCEL_URL — but setting it to your
# production domain is recommended once you have one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# reCAPTCHA v2 ("I'm not a robot" checkbox) — protects the /contact form
# from bots. Create keys at https://www.google.com/recaptcha/admin/create
# (choose reCAPTCHA v2 "I'm not a robot" Checkbox) and add both your domain
# and localhost. Until these are set, the contact form still works but
# skips captcha verification.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
